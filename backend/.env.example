NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/pawcircle
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=60
CORS_ORIGINS=http://localhost:8081
# Object storage (Cloudflare R2 is S3-compatible). Leave blank to disable document uploads.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pawcircle-media
# --- Community membership (paid) -------------------------------------------------------------
# Community (groups, posts, events) needs a membership. Set to 0 ONLY for local dev without payments.
ENFORCE_MEMBERSHIP=1
# What community access costs, in NIM (e.g. 1, 2.5, 0.5). Change it any time; restart the API to apply.
# MEMBERSHIP_DAYS=0 means a one-time payment with no expiry.
MEMBERSHIP_PRICE_NIM=1
MEMBERSHIP_DAYS=0
# --- Nimiq payments ----------------------------------------------------------------------------
# Leave NIMIQ_RECEIVE_ADDRESS empty to disable payments (the app then shows "payments unavailable").
NIMIQ_NETWORK=mainnet
NIMIQ_RECEIVE_ADDRESS=
# A Nimiq node JSON-RPC URL. Public open servers are for testing only; use your own node in production.
NIMIQ_RPC_URL=
NIMIQ_MIN_CONFIRMATIONS=2
PAYMENT_INTENT_TTL_MIN=60
# Reminder worker
REMINDER_POLL_SECONDS=30

# --- Hosting (see DEPLOY.md) -------------------------------------------------------------------
# Run the reminder scheduler inside the API process (one service instead of two).
RUN_WORKER_IN_PROCESS=1
# Reverse proxies in front of the API. 1 is right for most hosts; if every visitor shares one rate limit, raise it.
TRUST_PROXY_HOPS=1
# Where the built web app lives (default: ../frontend/dist next to the backend). The API serves it automatically.
# WEB_DIST_DIR=
